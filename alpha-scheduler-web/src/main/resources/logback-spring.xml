<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<!-- Level can be ALL, TRACE, DEBUG, INFO, WARN, ERROR, FATAL, OFF --> 
<!-- 
1.%logger {length} : Logger name의 이름을 축약할 수 있습니다. {length}는 최대 차릿수 입니다.
2.%thread : 현재 Thread name
3.%-5level : log level -5는 출력 고정폭 값
4.%msg : log message %message은 alias
5.%n : new line
--> 

<!-- 
rollingPolicy
 - fileNamePattern : 파일의 이름을 정의합니다. 해당 값은 파일 이름과 %d 변환지정자로 구성
 - cleanHistoryOnStart : 기본값은 false 입니다. ture이면 appender 시작시 로그 파일 제거가 실행이 됩니다. 로그 파일 제거는 일반적으로 롤오버 중에 수행이 되는데, 롤오버가 트리거되지 않을 만큼 오래 지속되지 않을 수 있기 때문에 해당 옵션을 설정하여 로그 파일 제거 가능
 - maxHistory : 보관할 파일의 최대수를 제어하여 오래된 파일을 비동기식으로 삭제합니다. 일간 롤오버가 지정되어 있고 maxHistory를 6으로 설정하면 6일 분량의 로그 파일은 유지가 되고 6일 이전의 로그 파일은 삭제 (0일 경우에는 최대 보관 기관 단위를 설정하지 않음)
 - totalSizeCap : 모든 로그 파일의 전체 크기를 제어합니다. 전체 크기 제한을 초과하면 가장 오래된 파일을 비동기식으로 삭제합니다. 해당 속성을 사용하기 위해서는 maxHistory가 설정되어 있어야 합니다.(0일 경우에는 최대 용량을 설정하지 않음, totalSizeCap은 항상 maxHistory가 먼저 적용된 뒤에 적용)
 -->
 
<configuration scan="true" scanPeriod="30 seconds">
 	<!-- <shutdownHook/> -->

	<property resource="application.yml" />
    <springProperty name="executionLogFilePath" source= "alpha.batch.scheduler.executionLogFilePathPattern" />
    <springProperty name="exceptionLogFilePath" source= "alpha.batch.scheduler.exceptionLogFilePathPattern" />
        
 	<include resource="org/springframework/boot/logging/logback/defaults.xml" />
 	
    <appender name="consoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
	        <charset>UTF-8</charset>
	        <!-- <pattern>${CONSOLE_LOG_PATTERN}</pattern>  -->
            <pattern>[%clr(%d{HH:mm:ss.SSS}){faint}][%clr(${LOG_LEVEL_PATTERN:-%5p})][%clr(%thread){faint}][%clr(%40logger{40}){cyan}][%clr(%3.3line){green}] %clr(:){faint} %m%n</pattern>
        </encoder>
    </appender>

	<appender name="rollingFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
      <encoder>
		<charset>UTF-8</charset>              	 
		<pattern>[%d{HH:mm:ss.SSS}][%-5level][%logger {100}][%method:%line]%msg%n</pattern>
      </encoder>
	  <file>${LOG_FILE}.log</file>
	  <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
		<fileNamePattern>${LOGBACK_ROLLINGPOLICY_FILE_NAME_PATTERN:-${LOG_FILE}.%d{yyyy-MM-dd}.%i.gz}</fileNamePattern>
		<cleanHistoryOnStart>${LOGBACK_ROLLINGPOLICY_CLEAN_HISTORY_ON_START:-true}</cleanHistoryOnStart>
		<maxHistory>${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-7}</maxHistory>
		<maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-10MB}</maxFileSize>
		<totalSizeCap>${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-100MB}</totalSizeCap>
	  </rollingPolicy>
	</appender>
	
	<appender name="sqlRollingFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<encoder>	
			<charset>UTF-8</charset>              	 
			<pattern>[%d{ISO8601}] %msg%n</pattern>
		</encoder>
   		<file>${LOG_FILE}.sql.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOGBACK_ROLLINGPOLICY_FILE_NAME_PATTERN:-${LOG_FILE}.sql.%d{yyyy-MM-dd}.%i.gz}</fileNamePattern>
			<cleanHistoryOnStart>${LOGBACK_ROLLINGPOLICY_CLEAN_HISTORY_ON_START:-true}</cleanHistoryOnStart> <!-- true일 경우 어플리케이션을 시작할 때 기존 아카이빙된 로그 파일들을 삭제 -->
			<maxHistory>${LOGBACK_ROLLINGPOLICY_MAX_HISTORY:-7}</maxHistory> <!-- 최대로 보관하는 파일의 개수 -->
			<maxFileSize>${LOGBACK_ROLLINGPOLICY_MAX_FILE_SIZE:-10MB}</maxFileSize> <!-- 로그 파일의 총 사이즈를 제한 (default:10MB)-->
			<totalSizeCap>${LOGBACK_ROLLINGPOLICY_TOTAL_SIZE_CAP:-100MB}</totalSizeCap> <!-- 아카이빙한 로그 파일의 최대 사이즈 (totalSizeCap은 항상 maxHistory가 먼저 적용된 뒤에 적용) -->
		</rollingPolicy>
	</appender>

	<appender name="taskExecutionSiftingAppender" class="com.alpha.base.support.log.KeyEffectiveSiftingAppender">
	  <filter class="com.alpha.base.support.batch.TaskLogFilter">
	    <metaTaskLogLevel>executionLogLevel</metaTaskLogLevel> <!-- for runtimeLogLevelChange -->
	  </filter>
	  <discriminator>
	    <key>executionLogFilePath</key>
	    <defaultValue>unknown</defaultValue>
	  </discriminator>
	  <timeout>5 seconds</timeout>
	  <sift>
	    <appender class="ch.qos.logback.core.FileAppender">
	      <file>${executionLogFilePath}</file>    
	      <encoder>
			<charset>UTF-8</charset> 
	        <pattern>[%d{yyyy/MM/dd HH:mm:ss.SSS}][%-5level][%logger {100}][%method:%line] %msg%n</pattern>
	      </encoder>
	    </appender>
	  </sift>
	</appender>

	<appender name="taskExceptionSiftingAppender" class="com.alpha.base.support.log.KeyEffectiveSiftingAppender">
	  <filter class="com.alpha.base.support.batch.TaskLogFilter">
		<metaTaskLogLevel>exceptionLogLevel</metaTaskLogLevel> <!-- for runtimeLogLevelChange -->
	  </filter>  	  
	  <discriminator>
	    <key>exceptionLogFilePath</key>
	    <defaultValue>unknown</defaultValue>
	  </discriminator>
	  <timeout>5 seconds</timeout>
	  <sift>
	    <appender class="ch.qos.logback.core.FileAppender">
	      <file>${exceptionLogFilePath}</file>    
	      <encoder>
			<charset>UTF-8</charset> 
	        <pattern>[%d{yyyy/MM/dd HH:mm:ss.SSS}][%-5level][%logger {100}][%method:%line] %msg%n</pattern>
	      </encoder>
	    </appender>
	  </sift>
	</appender>
	
	<!-- FrameWork로그 -->
	<logger name="org.jboss.logging" additivity="true" level="error" />	
	<logger name="org.ulisesbocchio" additivity="true" level="error" />	
	<logger name="org.springframework" additivity="true" level="error"/>
	<logger name="_org.springframework" additivity="true" level="error"/>
	<logger name="com.zaxxer.hikari" additivity="true" level="error"/>
	<logger name="io" additivity="true" level="error" />	
	<logger name="org" additivity="true" level="error" />	
	<logger name="log4jdbc" additivity="true" level="error" />	
	<logger name="reactor" additivity="true" level="error" />	
	<logger name="springfox" additivity="true" level="error" />	

	<!-- SQL로그 -->
	<logger name="log4jdbc.debug" level="warn" additivity="false">
		<appender-ref ref="sqlRollingFileAppender"/>
	</logger>	 
	<logger name="jdbc.connection" level="warn" additivity="false">
		<appender-ref ref="sqlRollingFileAppender"/>
	</logger>
	<logger name="jdbc.sqltiming" level="warn" additivity="false">
		<appender-ref ref="sqlRollingFileAppender"/>
	</logger>
	<logger name="jdbc.audit" level="warn" additivity="false">
		<appender-ref ref="sqlRollingFileAppender"/>
	</logger>
	<logger name="jdbc.sqlonly" level="debug" additivity="true">
		<appender-ref ref="sqlRollingFileAppender"/>
        <appender-ref ref="taskExecutionSiftingAppender" />
        <appender-ref ref="taskExceptionSiftingAppender" />	
	</logger>
	<logger name="jdbc.resultset" level="warn" additivity="true">
		<appender-ref ref="sqlRollingFileAppender"/>
        <appender-ref ref="taskExecutionSiftingAppender" />
        <appender-ref ref="taskExceptionSiftingAppender" />	
	</logger>
	<logger name="jdbc.resultsettable" level="debug" additivity="true" >
		<appender-ref ref="sqlRollingFileAppender"/>
        <appender-ref ref="taskExecutionSiftingAppender" />
        <appender-ref ref="taskExceptionSiftingAppender" />	
	</logger>

	<logger name="com.alpha" additivity="true">
        <appender-ref ref="taskExecutionSiftingAppender" />	
        <appender-ref ref="taskExceptionSiftingAppender" />	
	</logger>
	
    <root level="debug">
        <appender-ref ref="consoleAppender" />
        <appender-ref ref="rollingFileAppender" />
    </root>

</configuration>