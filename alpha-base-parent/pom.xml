<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- 프로젝트 기본 메타정보 -->
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.alpha.base</groupId>
    <artifactId>alpha-base-parent</artifactId>
    <version>x.x.x-SNAPSHOT</version>
    <packaging>pom</packaging>
    <description>alpha 공통프레임웍 POM-parent</description>

    <!-- Spring Boot Parent 설정 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <!-- 공통 속성 정의 -->
    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.fullReCompile>false</maven.compiler.fullReCompile>
        <maven.test.skip>true</maven.test.skip>
        <alpha.git.url>http://support.apollo.co.kr/gitlab/alpha</alpha.git.url>
    </properties>

    <!-- 배포 관리 (Nexus Repository) -->
    <distributionManagement>
        <repository>
            <id>maven-releases</id>
            <url>${repository.nexus.releasesLocation}</url>
        </repository>
        <snapshotRepository>
            <id>maven-snapshots</id>
            <url>${repository.nexus.snapshotsLocation}</url>
        </snapshotRepository>
    </distributionManagement>

    <!-- 소스 코드 관리 (SCM) -->
    <scm>
        <connection>scm:git:${alpha.git.url}/alpha-base-parent.git</connection>
        <url>${alpha.git.url}</url>
    </scm>

    <!-- 빌드 플러그인 관리 -->
    <build>
        <pluginManagement>
            <plugins>
                <!-- 빌드 넘버 생성 -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>buildnumber-maven-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <!-- 리소스 처리 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

	<dependencyManagement>
		
		<dependencies>
		
			<!-- Spring Cloud Config: 외부 설정 서버 연동 -->
			<dependency>
			    <groupId>org.springframework.cloud</groupId>
			    <artifactId>spring-cloud-config-client</artifactId>
			    <version>3.1.8</version>
			</dependency>
		
			<!-- Spring Boot 개발 편의 기능 (자동 리로드 등) -->
			<dependency>
			    <groupId>org.springframework.boot</groupId>
			    <artifactId>spring-boot-devtools</artifactId>
			    <version>2.7.18</version>
			</dependency>
		
			<!-- Spring Boot Redis 연동 -->
			<dependency>
			    <groupId>org.springframework.boot</groupId>
			    <artifactId>spring-boot-starter-data-redis</artifactId>
			    <version>2.7.18</version>
			</dependency>
		
			<!-- Spring Boot Thymeleaf 템플릿 엔진 -->
			<dependency>
			    <groupId>org.springframework.boot</groupId>
			    <artifactId>spring-boot-starter-thymeleaf</artifactId>
			    <version>2.7.18</version>
			</dependency>
		
			<!-- MyBatis ORM + Spring Boot 통합 -->
			<dependency>
			    <groupId>org.mybatis.spring.boot</groupId>
			    <artifactId>mybatis-spring-boot-starter</artifactId>
			    <version>2.3.2</version>
			</dependency>
		
			<!-- Kafka 메시징 연동 -->
			<dependency>
			    <groupId>org.springframework.kafka</groupId>
			    <artifactId>spring-kafka</artifactId>
			    <version>2.9.13</version>
			</dependency>
		
			<!-- Lombok: Getter/Setter/Builder 자동 생성 -->
			<dependency>
			    <groupId>org.projectlombok</groupId>
			    <artifactId>lombok</artifactId>
			    <version>1.18.32</version>
			</dependency>
		
			<!-- Logback Core: 로깅 프레임워크 핵심 모듈 -->
			<dependency>
			    <groupId>ch.qos.logback</groupId>
			    <artifactId>logback-core</artifactId>
			    <version>1.2.13</version>
			</dependency>
		
			<!-- Logback Classic: SLF4J 구현체 -->
			<dependency>
			    <groupId>ch.qos.logback</groupId>
			    <artifactId>logback-classic</artifactId>
			    <version>1.2.13</version>
			</dependency>
		
			<!-- Javassist: 바이트코드 조작 라이브러리 -->
			<dependency>
			    <groupId>javassist</groupId>
			    <artifactId>javassist</artifactId>
			    <version>3.12.1.GA</version>
			</dependency>
		
			<!-- JUnit: 단위 테스트 프레임워크 -->
			<dependency>
			    <groupId>junit</groupId>
			    <artifactId>junit</artifactId>
			    <version>4.13.2</version>
			</dependency>
		
			<!-- Commons IO: 파일 입출력 유틸리티 -->
			<dependency>
			    <groupId>commons-io</groupId>
			    <artifactId>commons-io</artifactId>
			    <version>2.15.1</version>
			</dependency>
		
			<!-- Commons Logging: 로깅 추상화 (다양한 로깅 프레임워크와 연동) -->
			<dependency>
			    <groupId>commons-logging</groupId>
			    <artifactId>commons-logging</artifactId>
			    <version>1.3.0</version>
			</dependency>
		
			<!-- Commons FileUpload: 파일 업로드 처리 -->
			<dependency>
			    <groupId>commons-fileupload</groupId>
			    <artifactId>commons-fileupload</artifactId>
			    <version>1.5</version>
			</dependency>
		
			<!-- Commons BeanUtils: Java Bean 조작 유틸리티 -->
			<dependency>
			    <groupId>commons-beanutils</groupId>
			    <artifactId>commons-beanutils</artifactId>
			    <version>1.8.3</version>
			</dependency>
		
			<!-- Apache Commons Compress: 압축/아카이브 처리 (ZIP, TAR 등) -->
			<dependency>
			    <groupId>org.apache.commons</groupId>
			    <artifactId>commons-compress</artifactId>
			    <version>1.25.0</version>
			</dependency>
		
			<!-- Apache Commons Text: 문자열 처리 유틸리티 -->
			<dependency>
			    <groupId>org.apache.commons</groupId>
			    <artifactId>commons-text</artifactId>
			    <version>1.12.0</version>
			</dependency>
		
			<!-- Apache Commons Lang3: 언어 확장 유틸리티 (StringUtils, ObjectUtils 등) -->
			<dependency>
			    <groupId>org.apache.commons</groupId>
			    <artifactId>commons-lang3</artifactId>
			    <version>3.14.0</version>
			</dependency>
		
			<!-- Apache Maven Model: Maven POM 파싱 및 모델 처리 -->
			<dependency>
			    <groupId>org.apache.maven</groupId>
			    <artifactId>maven-model</artifactId>
			    <version>3.0.2</version>
			</dependency>
		
			<!-- Kafka Clients: Kafka 메시지 브로커 클라이언트 -->
			<dependency>
			    <groupId>org.apache.kafka</groupId>
			    <artifactId>kafka-clients</artifactId>
			    <version>3.7.1</version>
			</dependency>
		
			<!-- Apache POI: MS Office 문서 처리 -->
			<dependency>
			    <groupId>org.apache.poi</groupId>
			    <artifactId>poi</artifactId>
			    <version>5.2.5</version>
			</dependency>
		
			<!-- Apache POI OOXML: MS Office OOXML 문서 처리 (xlsx, docx 등) -->
			<dependency>
			    <groupId>org.apache.poi</groupId>
			    <artifactId>poi-ooxml</artifactId>
			    <version>5.2.5</version>
			</dependency>
		
			<!-- Springdoc OpenAPI UI: REST API 문서화 및 Swagger UI 제공 -->
			<dependency>
			    <groupId>org.springdoc</groupId>
			    <artifactId>springdoc-openapi-ui</artifactId>
			    <version>1.7.0</version>
			</dependency>
			<!-- DB 드라이버: 인메모리 테스트용 H2 -->
			<dependency>
			    <groupId>com.h2database</groupId>
			    <artifactId>h2</artifactId>
			    <version>2.2.224</version>
			</dependency>
		
			<!-- DB 드라이버: MySQL JDBC -->
			<dependency>
			    <groupId>com.mysql</groupId>
			    <artifactId>mysql-connector-j</artifactId>
			    <version>8.4.0</version>
			</dependency>
		
			<!-- Embedded Redis: 테스트 환경에서 Redis 서버 임베딩 -->
			<dependency>
			    <groupId>it.ozimov</groupId>
			    <artifactId>embedded-redis</artifactId>
			    <version>0.7.3</version>
			    <exclusions>
				<!-- SLF4J 단순 로거 제외 (충돌 방지) -->
				<exclusion>
				    <groupId>org.slf4j</groupId>
				    <artifactId>slf4j-simple</artifactId>
				</exclusion>
			    </exclusions>
			</dependency>
		
			<!-- Redis 클라이언트: Lettuce -->
			<dependency>
			    <groupId>io.lettuce</groupId>
			    <artifactId>lettuce-core</artifactId>
			    <version>6.3.2.RELEASE</version>
			</dependency>
		
			<!-- Tomcat HA: 클러스터링 및 고가용성 지원 -->
			<dependency>
			    <groupId>org.apache.tomcat</groupId>
			    <artifactId>tomcat-catalina-ha</artifactId>
			    <version>9.0.83</version>
			</dependency>
		
			<!-- SQL 로그 출력: JDBC 호출 로깅 -->
			<dependency>
			    <groupId>org.bgee.log4jdbc-log4j2</groupId>
			    <artifactId>log4jdbc-log4j2-jdbc4.1</artifactId>
			    <version>1.16</version>
			</dependency>
		
			<!-- JWT 토큰 처리 -->
			<dependency>
			    <groupId>io.jsonwebtoken</groupId>
			    <artifactId>jjwt-api</artifactId>
			    <version>0.11.5</version>
			</dependency>
			<dependency>
			    <groupId>io.jsonwebtoken</groupId>
			    <artifactId>jjwt-impl</artifactId>
			    <version>0.11.5</version>
			</dependency>
			<dependency>
			    <groupId>io.jsonwebtoken</groupId>
			    <artifactId>jjwt-jackson</artifactId>
			    <version>0.11.5</version>
			</dependency>
		
			<!-- Guava: 구글 공통 유틸리티 라이브러리 -->
			<dependency>
			    <groupId>com.google.guava</groupId>
			    <artifactId>guava</artifactId>
			    <version>33.0.0-jre</version>
			</dependency>
		
			<!-- Jackson Core: 가장 널리 쓰이는 JSON 직렬화/역직렬화 라이브러리 -->
			<dependency>
			    <groupId>com.fasterxml.jackson.core</groupId>
			    <artifactId>jackson-core</artifactId>
			    <version>2.16.0</version>
			</dependency>
		
			<!-- org.json: 간단한 JSON 객체 생성/파싱용 라이브러리 -->
			<dependency>
			    <groupId>org.json</groupId>
			    <artifactId>json</artifactId>
			    <version>20231013</version>
			</dependency>
		
			<!-- Google Auto Service: 어노테이션 기반 서비스 등록 (JSON 직접 관련은 아님, 빌드 시 유틸) -->
			<dependency>
			    <groupId>com.google.auto.service</groupId>
			    <artifactId>auto-service</artifactId>
			    <version>1.1.1</version>
			</dependency>
		
			<!-- Gson: 구글에서 제공하는 JSON 직렬화/역직렬화 라이브러리 -->
			<dependency>
			    <groupId>com.google.code.gson</groupId>
			    <artifactId>gson</artifactId>
			    <version>2.10.1</version>
			</dependency>
		
			<!-- JSON-Simple: 경량 JSON 파서 (작은 프로젝트에서 주로 사용) -->
			<dependency>
			    <groupId>com.googlecode.json-simple</groupId>
			    <artifactId>json-simple</artifactId>
			    <version>1.1.1</version>
			</dependency>
		
			<!-- JSON Sanitizer: 잘못된 JSON을 안전하게 정리/보정 -->
			<dependency>
			    <groupId>com.mikesamuel</groupId>
			    <artifactId>json-sanitizer</artifactId>
			    <version>1.2.3</version>
			</dependency>
		
			<!-- AWS SDK for S3: Amazon S3 연동 -->
			<dependency>
			    <groupId>com.amazonaws</groupId>
			    <artifactId>aws-java-sdk-s3</artifactId>
			    <version>1.11.238</version>
			</dependency>
		
			<!-- SSHJ: SSH 클라이언트 라이브러리 (파일 전송, 원격 접속 지원) -->
			<dependency>
			    <groupId>com.hierynomus</groupId>
			    <artifactId>sshj</artifactId>
			    <version>0.37.0</version>
			</dependency>
		
			<!-- Snappy: 구글의 고속 압축 알고리즘 구현체 -->
			<dependency>
			    <groupId>org.xerial.snappy</groupId>
			    <artifactId>snappy-java</artifactId>
			    <version>1.1.10.5</version>
			</dependency>
		
			<!-- Jasypt: 문자열/설정 값 암호화 라이브러리 -->
			<dependency>
			    <groupId>org.jasypt</groupId>
			    <artifactId>jasypt</artifactId>
			    <version>1.9.3</version>
			</dependency>
		
			<!-- Jasypt Spring Boot Starter: Spring Boot 환경에서 Jasypt 암호화 기능 통합 -->
			<dependency>
			    <groupId>com.github.ulisesbocchio</groupId>
			    <artifactId>jasypt-spring-boot-starter</artifactId>
			    <version>3.0.5</version>
			</dependency>
						
			<dependency>
			    <groupId>org.openjdk.jol</groupId>
			    <artifactId>jol-core</artifactId>
			    <version>0.17</version>
			</dependency>
						
			<!-- OSHI: 시스템 정보(CPU/메모리/디스크/센서 등) 조회 -->
			<dependency>
				<groupId>com.github.oshi</groupId>
				<artifactId>oshi-core</artifactId>
				<version>6.4.0</version>
			</dependency>
						
		</dependencies>
		
	</dependencyManagement>

</project>